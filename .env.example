# Frontend
VITE_API_URL=http://localhost:8000/api
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Backend
# PostgreSQL: use asyncpg. All datetime columns use UTC (TIMESTAMPTZ after migration 0002).
# Cloud SQL example: postgresql+asyncpg://USER:PASSWORD@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql+asyncpg://proctoride:proctoride@localhost:5432/proctoride
JUDGE0_URL=http://localhost:2358
# Firebase Admin SDK JSON path (required in production for token verification)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=
# Recommended on servers so logs and subprocesses default to UTC
TZ=UTC
